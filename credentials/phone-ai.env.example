# Copy to .env (never commit .env). Load it however you like, e.g.:  node --env-file=.env ...
# Every value here is a placeholder. Real values come from your own accounts.

# --- Safety: leave on 'off' until you have finished SETUP.md stage 3
PHONEAI_PHASE=off

# --- About your business (spoken to callers)
PHONEAI_BUSINESS_NAME=<YOUR_BUSINESS_NAME>
PHONEAI_ASSISTANT_NAME=Alex
PHONEAI_TIMEZONE=Australia/Sydney
PHONEAI_REGION=AU
PHONEAI_HOURS_FILE=./hours.json

# --- Vapi (https://dashboard.vapi.ai)
PHONEAI_VAPI_API_KEY=<YOUR_VAPI_PRIVATE_API_KEY>
PHONEAI_VAPI_WEBHOOK_SECRET=<MAKE_UP_A_LONG_RANDOM_STRING>
PHONEAI_VAPI_PHONE_NUMBER_ID=<FROM_VAPI_DASHBOARD_PHONE_NUMBERS>
PHONEAI_VAPI_ASSISTANT_ID=<FILLED_IN_AFTER_setup-vapi_--live>
PHONEAI_VAPI_TEST_ASSISTANT_ID=<FILLED_IN_AFTER_setup-vapi_--test_--live>
PHONEAI_PUBLIC_URL=https://<YOUR_PUBLIC_SERVER_ADDRESS>
PHONEAI_VOICE_PROVIDER=11labs
PHONEAI_VOICE_ID=<A_VOICE_ID_FROM_VAPI_DASHBOARD>

# --- Where messages go besides the local database
PHONEAI_SINK=sqlite
# PHONEAI_SINK=webhook
# PHONEAI_SINK_WEBHOOK_URL=https://<YOUR_ENDPOINT>

# --- Email notices and the daily review (optional; without it they are written to the log)
PHONEAI_NOTIFY_EMAIL_TO=<YOUR_EMAIL>
PHONEAI_SMTP_HOST=<YOUR_SMTP_HOST>
PHONEAI_SMTP_PORT=587
PHONEAI_SMTP_USER=<YOUR_SMTP_USER>
PHONEAI_SMTP_PASS=<YOUR_SMTP_PASSWORD>
PHONEAI_SMTP_FROM=<phone-ai@YOUR_DOMAIN>

# --- Limits
PHONEAI_DAILY_COST_CAP_USD=10
PHONEAI_AUTO_DETACH=true
