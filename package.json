{
  "name": "phone-ai",
  "version": "0.1.0",
  "description": "v1: an AI phone agent that answers when nobody can, built up one safe step at a time (Vapi).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run tests/smoke.test.ts",
    "robot": "node --env-file-if-exists=.env --import tsx robot/run.ts",
    "setup-vapi": "node --env-file-if-exists=.env --import tsx src/cli/setupVapi.ts",
    "switch": "node --env-file-if-exists=.env --import tsx src/cli/switch.ts",
    "digest": "node --env-file-if-exists=.env --import tsx src/cli/digest.ts",
    "shadow": "node --env-file-if-exists=.env --import tsx src/shadow/review.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
